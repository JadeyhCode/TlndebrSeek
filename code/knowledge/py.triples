# §6.955 扩模板：把 blind20 里“本地没有”的常见形态补上（数据，不改代码）
py模板:阶乘	关键词	阶乘
py模板:阶乘	代码	import sys\
n = int(sys.stdin.read().strip())\
r = 1\
for i in range(2, n + 1):\
    r *= i\
print(r)
py模板:阶乘	测试	5=>120
py模板:阶乘	测试	1=>1

py模板:回文	关键词	是不是回文
py模板:回文	关键词	回文
py模板:回文	代码	import sys\
s = sys.stdin.readline().strip()\
print("yes" if s == s[::-1] else "no")
py模板:回文	测试	level=>yes
py模板:回文	测试	abc=>no

py模板:数位和	关键词	各位数字之和
py模板:数位和	代码	import sys\
print(sum(int(c) for c in sys.stdin.read().strip() if c.isdigit()))
py模板:数位和	测试	1234=>10
py模板:数位和	测试	90=>9

py模板:去重保序	关键词	去重后按原顺序
py模板:去重保序	代码	import sys\
out = []\
for x in sys.stdin.read().split():\
    if x not in out:\
        out.append(x)\
print(" ".join(out))
py模板:去重保序	测试	1 2 1 3=>1 2 3
py模板:去重保序	测试	5 5 6=>5 6

py模板:斐波那契	关键词	斐波那契
py模板:斐波那契	代码	import sys\
n = int(sys.stdin.read().strip())\
a, b = 0, 1\
for _ in range(n):\
    a, b = b, a + b\
print(a)
py模板:斐波那契	测试	7=>13
py模板:斐波那契	测试	0=>0

py模板:大于计数	关键词	大于 5 的个数
py模板:大于计数	代码	import sys\
data = [int(x) for x in sys.stdin.read().split()]\
print(sum(1 for x in data if x > 5))
py模板:大于计数	测试	1 9 6 2=>2
py模板:大于计数	测试	5 5=>0

py模板:单词个数	关键词	单词的个数
py模板:单词个数	关键词	几个单词
py模板:单词个数	代码	import sys\
print(len(sys.stdin.read().split()))
py模板:单词个数	测试	a bb ccc=>3
py模板:单词个数	测试	=>0

py模板:数字倒序	关键词	倒序输出
py模板:数字倒序	关键词	把一行数字倒序输出
py模板:数字倒序	代码	import sys\
print(" ".join(reversed(sys.stdin.read().split())))
py模板:数字倒序	测试	1 2 3=>3 2 1
py模板:数字倒序	测试	a b=>b a

py模板:负数清零	关键词	负数都变成 0
py模板:负数清零	关键词	把负数都变成 0
py模板:负数清零	代码	import sys\
data = [int(x) for x in sys.stdin.read().split()]\
print(" ".join(str(0 if x < 0 else x) for x in data))
py模板:负数清零	测试	-1 2 -3=>0 2 0
py模板:负数清零	测试	0 -5=>0 0
# §6.955b 歧义修复：“加起来”是求和的口语，但“各位数字加起来”是数位和——长的先命中
